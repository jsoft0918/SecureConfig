<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SecureConfig .NET Framework 4.8 sample (ASP.NET 4.8 / IIS pattern)

    - Program.cs        : console demo you can run right away
    - AppConfig.cs      : app-wide settings class (Debug=local, Release=app pool environment variable)  <- copy as-is
    - ConfigGuard.cs    : guard that returns 503 when settings cannot be read (ASP.NET 4.8)             <- copy as-is
    - Global.asax.cs    : example of wiring up the guard

    In a real .NET Framework project (legacy csproj), reference the DLL directly instead of using ProjectReference:
      <Reference Include="SecureConfig">
        <HintPath>..\lib\SecureConfig\SecureConfig.dll</HintPath>
        <Private>True</Private>
      </Reference>
    (You can copy the DLL there with: build.bat ..\MyApp\lib\SecureConfig)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecureConfig\SecureConfig.csproj" />
    <Reference Include="System.Web" />
  </ItemGroup>

</Project>
